# --- from the standard Node template, the parts that apply here ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets, the host identity among them.
.env
.env.*
!.env.example

# OS junk. Development is on Windows, the container harness runs on Linux.
Thumbs.db
desktop.ini
.DS_Store

# Git Bash crash debris. Written into the repo root by whichever shell died.
*.stackdump

# --- this project ---

# Build output — esbuild regenerates these from `public/`. Tracking them means
# every source edit shows twice in the diff, once as cause and once as effect.
*.bundle.js
*.bundle.css
*.bundle.js.map

# Generated media — `npm run content` in app/ rebuilds it (~2.3 GB, 1800
# fMP4 segments of synthetic testsrc2).
app/content/

# Personal test media, read by the keyframe report. Never committed.
test_videos/


# IDE workspace state. Per-machine and per-developer — module paths, code-style
# defaults, VCS mappings — and it carries none of the project's reasoning.
.idea/
*.iml
.vscode/

# NOT ignored, deliberately:
#   *.md anywhere — the docs are the review surface, and belong inside the diff
#     a review reads. An untracked doc is the one thing a review cannot undo.
#   package-lock.json — the hls.js version is load-bearing.

# Chrome/crashpad debris. Written into the repo root by the browser dev aids
# and by tooling that launches them.
debug.log
.tmp/

