{
  "name": "watchalong-app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Synced P2P Watchalong — room server, signalling transport, and the plain pages changes 2-10 build on.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server/room-server.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:file": "node scripts/dev.mjs --file",
    "build": "node scripts/check-structure.mjs && node scripts/build.mjs",
    "check": "node scripts/check-structure.mjs && node scripts/protocol-check.mjs",
    "ratios": "node scripts/check-structure.mjs --ratios",
    "verify:browser": "node scripts/verify-browser.mjs",
    "harness:build": "node scripts/harness/images.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "bittorrent-tracker": "11.2.3",
    "clsx": "2.1.1",
    "hls.js": "^1.7.0",
    "lucide-react": "1.59.0",
    "mp4box": "2.4.1",
    "p2p-media-loader-core": "3.0.1",
    "p2p-media-loader-hlsjs": "3.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tailwindcss": "3.4.19"
  }
}
