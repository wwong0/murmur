# Copy to /etc/murmur/room.env as root:murmur with mode 0640; never commit the copy.
# KEY=value with no quotes: systemd's EnvironmentFile reads this file and strips quotes.
APP_PORT=8100
APP_MEDIA_SOURCE=file
APP_DELIVERY=host
APP_TRACKER_URL=wss://murmurwatch.duckdns.org/tracker
APP_ALLOWED_ORIGIN=https://murmurwatch.duckdns.org
APP_TRUSTED_PROXY=1
# Usage totals only (13i D1); systemd's StateDirectory creates /var/lib/murmur.
APP_USAGE_FILE=/var/lib/murmur/usage.json

# Fill these on the machine only; empty values make the server refuse to start.
APP_TURN_KEY_ID=
APP_TURN_API_TOKEN=

# Left unset on the instance; the code default applies.
# Must stay unset: set, /harness/counters answers to anyone (13 D3).
#APP_HARNESS_COUNTERS=
#APP_AUTO_START=
# The minted relay answer carries the relay's entries. If ever set: non-TURN URLs only (D7),
# and the JSON inside single quotes.
#APP_ICE_SERVERS=
#APP_MEDIA_DIR=
#APP_SEGMENT_TARGET_S=
#APP_LIVENESS_INTERVAL_MS=
#APP_HOST_GRACE_MS=
#APP_CHAT_BURST=
#APP_CHAT_REFILL_MS=
#APP_ENVELOPE_BURST=
#APP_ENVELOPE_REFILL_MS=
#APP_JOIN_BURST=
#APP_JOIN_REFILL_MS=
#APP_FRAME_CAP_BYTES=
#APP_TURN_API_BASE=
#APP_TURN_TTL_S=
#APP_TURN_REUSE_MS=
